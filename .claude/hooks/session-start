#!/bin/bash
# ABOUTME: Session start hook to install iOS development tools (Xcode or xtool)
# ABOUTME: Runs automatically when a new Claude Code web session starts

set -e

echo "🔧 Setting up iOS development environment..."

# Check if running in a Linux environment (Claude Code on the web)
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    echo "🐧 Linux environment detected"
    echo ""
    echo "📋 iOS Build Options on Linux:"
    echo "   1. xtool - Cross-platform Xcode replacement (recommended for Linux)"
    echo "   2. macOS with Xcode - Traditional approach"
    echo "   3. GitHub Actions - Automated builds"
    echo ""

    # Check if xtool is already installed
    if command -v xtool &> /dev/null; then
        echo "✅ xtool already installed: $(xtool --version 2>/dev/null || echo 'unknown version')"
    else
        echo "📦 xtool not found. To install:"
        echo ""
        echo "   # Install prerequisites:"
        echo "   sudo apt-get update"
        echo "   sudo apt-get install -y usbmuxd libimobiledevice-utils"
        echo ""
        echo "   # Install Swift 6.2 from https://swift.org/install/linux"
        echo ""
        echo "   # Install xtool:"
        echo "   curl -fL https://github.com/xtool-org/xtool/releases/latest/download/xtool-\$(uname -m).AppImage -o xtool"
        echo "   chmod +x xtool"
        echo "   sudo mv xtool /usr/local/bin/"
        echo ""
        echo "   # Setup xtool (requires Apple ID):"
        echo "   xtool setup"
        echo ""
        echo "   Note: You'll need to download Xcode.xip from Apple Developer"
        echo "   https://download.developer.apple.com/Developer_Tools/"
        echo ""
    fi

    # Check for Swift
    if command -v swift &> /dev/null; then
        echo "✅ Swift compiler: $(swift --version | head -n 1)"
    else
        echo "⚠️  Swift not installed - required for xtool"
        echo "   Install from: https://swift.org/install/linux"
    fi

    # Check for usbmuxd
    if command -v usbmuxd &> /dev/null; then
        echo "✅ usbmuxd available"
    else
        echo "⚠️  usbmuxd not installed - required for iOS device communication"
    fi

    echo ""
    echo "📖 Learn more about xtool: https://github.com/xtool-org/xtool"
    echo "   xtool allows building iOS apps on Linux using SwiftPM"
    echo ""

elif [[ "$OSTYPE" == "darwin"* ]]; then
    # Running on macOS
    echo "🍎 Detected macOS environment"

    # Check if Xcode command-line tools are already installed
    if xcode-select -p &> /dev/null; then
        echo "✅ Xcode command-line tools already installed at: $(xcode-select -p)"
    else
        echo "📥 Installing Xcode command-line tools..."

        # Install command-line tools
        xcode-select --install

        # Wait for installation to complete
        echo "⏳ Waiting for installation to complete..."
        until xcode-select -p &> /dev/null; do
            sleep 5
        done

        echo "✅ Xcode command-line tools installed successfully"
    fi

    # Verify tools are working
    if command -v swift &> /dev/null; then
        echo "✅ Swift compiler: $(swift --version | head -n 1)"
    fi

    if command -v xcodebuild &> /dev/null; then
        echo "✅ xcodebuild available"
    fi
else
    echo "⚠️  Unknown operating system: $OSTYPE"
fi

echo ""
echo "🎯 Session setup complete!"
echo ""
